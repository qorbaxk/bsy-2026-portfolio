# 배포 도메인. 사이트맵, canonical, Open Graph, JSON-LD의 기준 주소로 쓰인다.
NEXT_PUBLIC_SITE_URL=https://example.com

# GitHub Pages 배포 빌드용(워크플로가 자동으로 설정하므로 로컬에서는 필요 없다).
# STATIC_EXPORT=true면 정적 파일(out/)로 내보내고, 이때는 서버가 보내는 보안 헤더를 쓸 수 없다.
# NEXT_PUBLIC_BASE_PATH는 저장소 이름 경로로 서비스될 때만 지정한다(예: /bsy-2026-portfolio).
STATIC_EXPORT=false
NEXT_PUBLIC_BASE_PATH=
